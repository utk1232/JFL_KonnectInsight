<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <link rel="stylesheet" href="globals.css" />
    <link rel="stylesheet" href="/css/requestResolved.css" />
    <link href="https://fonts.googleapis.com/css?family=Montserrat" rel="stylesheet" />
  </head>
  <body>
    <div class="div">
      <div class="div-2">
        <!-- Hidden input for empName -->
        <input type="hidden" name="empName" value="<%= empName %>" />
        <div style="align-self: center">
          <button class="btn btn-danger" type="button" onclick="logout()">Logout</button>
        </div>
 
        <img
          loading="lazy"
          src="https://cdn.builder.io/api/v1/image/assets/TEMP/0f2463060321b3868a1cfcb33595061df522bfff36bfdc25615b27afaf1f53c8?"
          class="img"
        />
        <div class="div-14">
          <div class="div-15">
            <div class="div-16">
              <span style="font-weight: 600">Your Service Request Number is: <%= feedId %></span>
            </div>
            <div class="div-17">
              Our Guest Services representative will reach out to you within 24-48 hours.
            </div>
          </div>
        </div>
        <button class="div-18 cursor" onclick="closePage()">Close</button>
      </div>
    </div>
    <script>
      function closePage() {
        // Add your page closing logic here
        window.location.href = "http://localhost:3000/welcome";
        console.log("Page closed.");
      }
      function logout() {
        console.log("Logging out");
 
        fetch("/logout", { method: "POST" })
          .then((response) => {
            if (response.ok) {
              isLoggedOut = true;
 
              window.history.replaceState(null, null, "/home");
              window.location.href = "/home";
            } else {
              console.error("Logout failed:", response.statusText);
            }
          })
          .catch((error) => {
            console.error("Error during logout:", error);
          });
      }
      window.onpopstate = function () {
        if (isLoggedOut) {
          window.location.replace("/home");
        }
      };
      const comment =sessionStorage.getItem("userComment");
      const storedOrderDetails = sessionStorage.getItem("orderDetails");
      const storedCategory = sessionStorage.getItem("selectedCategory");
      const storedSubcategory = sessionStorage.getItem("selectedSubcategory");
      const selectedCategoryId = sessionStorage.getItem("selectedCategoryId");
     
      const selectedSubcategoryId = sessionStorage.getItem("selectedSubcategoryId");
    </script>
  </body>
</html>