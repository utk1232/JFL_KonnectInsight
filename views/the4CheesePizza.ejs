            cursor: pointer;
            border: 1px solid #2B57A6;
            padding: 5px 21px;
            border-radius: 20px;
            margin-top: 10px;
        }
 
        .sub {
            display: flex;
        }
 
        .highlighted-category {
            background-color: blue;
            color: white;
        }
        .employee-name {
            margin: 0;
            text-align: right;
            color: #1b4d76;
            padding-bottom: 8px;
            font-weight: bold;
        }
    </style>
</head>
 
<body>
    <form action="/feedbackCategory" method="post" id="feedbackCategory">
   
    <div id="the4pizza">
        <div class="parent1">
            <div class="inner-1">
 
                <div class="div-4" style="margin-left: 20px; justify-content: flex-start; align-items: flex-start;"></div>
                <div
              style="
                display: flex;
                justify-content: flex-end;
                align-items: flex-start;
                width: 100%;
              "
            >
           
 
              <div
                style="
                  display: flex;
                  flex-direction: column;
                  align-items: flex-end;
                  margin-bottom: 25px;
                "
              >
               
               
                <div class="employee-name"><%= empName %></div>
               
                 <div style="align-self: center">
                  <button
                    class="btn btn-danger"
                    type="button"
                    onclick="logout()"
                  >
                    Logout
                  </button>
                </div>
              </div>
            </div>
                <p class="child-1">Please select what you want to give feedback for</p>
                <div class="inner-2">
                    <div class="inner-3">
                        <p class="child-2"></p>
                        <div class="inner-4">
                           
                            <!-- Display the Order Date -->
                            <div class="child-3" id="orderDetails"></div> <!-- Order Date -->
                            <div class="child-3">
                                <div class="totalPrice"></div> <!-- Order Total -->
                            </div>
                        </div>
                       
                    </div>
                    <!-- <button class="child-4" onclick="backPage()">Back to Order Selection</button> -->
                </div>
                <div class="inner-5" >
                     <% console.log(orders, "orders in the4cheesepizza ejs"); %>
                    <% if (orders.length> 0) { %>
                        <ul class="ul">
                            <% let count=0; %>
                                <% for (let i=0; i < orders.length; i++) { %>
                                    <% let data=orders[i]; %>
                                        <div class="hlo">
                                            <%= data.displayText %>
                                        </div> <br>
                                        <% let orderCategories=orders[i].categories; %>
                                            <%let subcategories; %>
                                                <% for (let j=0;j<orderCategories.length;j++){%>
                                                    <span class="hlo1">
                                                        <%= orderCategories[j].displayText %>
                                                    </span>
                                                    <% } %>
                                                        <br>
                                                        <hr style="margin-top: 2%;">
                                                        <% for (let k=0; k < orderCategories.length; k++) { %>
                                                            <div class="category" onclick="clickCategory()">
                                                                <%= orderCategories[k].categoryName %>
                                                            </div>
 
                                                            <% subcategories=orderCategories[k].subCategories; %>
                                                                <div class="subcategories-container"
                                                                    id="subcategories-<%= k %>">
                                                                    <% for (let y=0; y < subcategories.length; y++) { %>
                                                                        <p class="subcategory<%= count %> allSubCategories sub"
                                                                            style="display: none;"
                                                                            onclick="handleClick(this)">
                                                                            <%= subcategories[y].displayText %>
                                                                        </p>
                                                                     <% } %>
                                                                            <% count++; %>
                                                                </div>
                                                                <% } %>
                                                                    <br>
                                                                    <% } %>
                        </ul>
                        <% } else { %>
                            <p>No orders found.</p>
                            <% } %>
                </div>
 
                <div class="inner-13" id="continueButton" onclick="feedbackPage()">
                    <div class="inner-14">
                        <div class="inner-15">Continue </div>
                        </div>
                </div>
               
            </div>
        </div>
 
    </div>
    </form>
   
    <script>
        let currentlyVisibleSubcategory = null;
        let previouslyClickedCategory = null; // Make it global
        let previouslyClickedSubcategory = null; // Make it global
       
        function handleClick(element) {
            var clickedValue = element.innerText;
            element.style.backgroundColor = 'blue';
            element.style.color = 'white';
            console.log(clickedValue, "clicked value");
       
            var previouslyClicked = document.querySelector('.clicked');
            if (previouslyClicked) {
                previouslyClicked.style.backgroundColor = 'white';
                previouslyClicked.style.color = 'black';
                previouslyClicked.classList.remove('clicked');
            }
            element.classList.add('clicked');
       
            // Save the selected subcategory in sessionStorage
            sessionStorage.setItem("selectedSubcategory", clickedValue);
        }
       
        function clickCategory() {
            let categories = document.querySelectorAll(".hlo1");
       
            for (let i = 0; i < categories.length; i++) {
                categories[i].addEventListener('click', () => {
                    let subcategories = document.querySelectorAll(`.subcategory${i}`);
       
                    // Reset previously clicked category
                    if (previouslyClickedCategory) {
                        previouslyClickedCategory.classList.remove('highlighted-category');
                    }
       
                    // Highlight the clicked category
                    categories[i].classList.add('highlighted-category');
                    previouslyClickedCategory = categories[i]; // Update the global variable
       
                    // Save the selected category in sessionStorage
                    sessionStorage.setItem("selectedCategory", categories[i].innerText);
       
                    // Toggle the subcategories display
                    if (currentlyVisibleSubcategory && currentlyVisibleSubcategory !== subcategories) {
                        currentlyVisibleSubcategory.forEach(subcat => subcat.style.display = 'none');
                    }
       
                    subcategories.forEach(subcat => {
                        subcat.style.display = subcat.style.display === 'none' || !subcat.style.display ? 'block' : 'none';
                    });
       
                    currentlyVisibleSubcategory = subcategories;
                });
            }
        }
       
        // Retrieve stored category and subcategory from sessionStorage
   
