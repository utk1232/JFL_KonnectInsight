console.log('Selected Order ID:', selectedOrderId);
 
 
 
 
function feedbackPage() {
    var elementToHandle = document.querySelector('.clicked');
    const storedOrderDetails = sessionStorage.getItem("orderDetails");
 
    const orderDetails=JSON.parse(storedOrderDetails);
    console.log(storedOrderDetails,orderDetails,"details");
    const storedOrderDate = sessionStorage.getItem("orderDate");
    const storeTotal=sessionStorage.getItem("orderTotal");
    console.log(elementToHandle);
 
    if (elementToHandle) {
        // handleClick(elementToHandle);
    }
 
    // Check if a category has been clicked
    const selectedCategory = previouslyClickedCategory
        ? previouslyClickedCategory.innerText
        : 'No category selected';
 
    // Check if a subcategory is clicked
    const selectedSubcategory = document.querySelector('.clicked')?.innerText || 'N/A';
 
    // Prepare data to send
    const dataToSend = {
        orderDetails,
        selectedCategory,
        selectedSubcategory
    };
   
    console.log(dataToSend, "data");
   
    fetch('/feedbackCategory', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        },
        body: JSON.stringify(dataToSend) // Sending the data in JSON format
    })
   
 
    .then(response => {
        if (response.ok) { // Ensure response is OK
         console.log(" pizza",response);
         document.getElementById('feedbackCategory').submit();
        // Redirect after successful submission
        } else {
            throw new Error('Network response was not ok.');
        }
    })
    .catch(error => {
        console.error('There was a problem with the fetch operation:', error);
    });
   
       
}
 
function fetchOrderDetails() {
    const storedOrderDetails = sessionStorage.getItem("orderDetails");
    const storedOrderDate = sessionStorage.getItem("orderDate");
    const storeTotal=sessionStorage.getItem("orderTotal");
    console.log(storedOrderDate,storeTotal,"daata");
    document.getElementById('orderDetails').innerText =storedOrderDate;
    document.querySelector('.totalPrice').innerText =`${storeTotal}`;
   
}
 
